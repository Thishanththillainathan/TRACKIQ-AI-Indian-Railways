# ============================================================
# RAILOPT AI — Frontend Environment Variables (.env.example)
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# NEVER use VITE_ prefix for provider API keys —
# those must stay in backend/.env only.
# ============================================================

# Supabase Project Credentials (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (FastAPI server)
# Set to the running backend URL — default port is 8010
VITE_API_URL=http://127.0.0.1:8010

# Demo officer login credentials (used by Login.jsx quick-access buttons)
VITE_DEMO_TRACK_EMAIL=track.officer@example.com
VITE_DEMO_TRACK_PASSWORD=Track@123

VITE_DEMO_ST_EMAIL=st.officer@example.com
VITE_DEMO_ST_PASSWORD=ST@123

VITE_DEMO_TRD_EMAIL=trd.officer@example.com
VITE_DEMO_TRD_PASSWORD=TRD@123

# Report access password shown in the Reports UI
# NOTE: This is a UI-level access gate only.
# For production, enforce password verification through the backend endpoint.
VITE_REPORT_PASSWORD=RailOpt@2026

# Optional: Satellite map tile providers (StationSatelliteModal)
# If neither key is set, the modal falls back to ArcGIS World Imagery (free, no key needed).
# VITE_MAPBOX_TOKEN=your_mapbox_access_token
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
